LLM_PROVIDER=gemini            # gemini | claude | local
LLM_MAX_PARALLEL=2             # parallel AI requests; keep 1-2 on a free-tier key
LLM_MAX_RPM=4                  # requests per minute; free-tier Gemini allows 5. 0 = unlimited
GEMINI_API_KEY=                # from https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-flash-latest   # gemini-pro-latest = best accuracy (lower free-tier limits)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_FAST_MODEL=claude-haiku-5-5
LOCAL_BASE_URL=http://localhost:8001/v1   # vLLM / Ollama OpenAI-compatible endpoint
LOCAL_MODEL=Qwen/Qwen2.5-VL-32B-Instruct
RULES_DIR=knowledge/rules
COMPILED_RULES=knowledge/compiled/rules.json
DESIGNS_DIR=designs
