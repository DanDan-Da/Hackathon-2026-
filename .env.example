# Comments stay on their own lines: `docker run --env-file` does not strip inline comments.
# gemini | claude | local
LLM_PROVIDER=gemini
# parallel AI requests; keep 1-2 on a free-tier key
LLM_MAX_PARALLEL=2
# requests per minute; free-tier Gemini allows 5. 0 = unlimited
LLM_MAX_RPM=4
# from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# the -latest aliases are not available to new keys. Free tier: 20 requests/DAY per model
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_FAST_MODEL=claude-haiku-5-5
# vLLM / Ollama OpenAI-compatible endpoint (inside Docker use http://host.docker.internal:8001/v1)
LOCAL_BASE_URL=http://localhost:8001/v1
LOCAL_MODEL=Qwen/Qwen2.5-VL-32B-Instruct
RULES_DIR=knowledge/rules
COMPILED_RULES=knowledge/compiled/rules.json
DESIGNS_DIR=designs
